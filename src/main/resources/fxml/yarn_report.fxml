<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobwork.controller.YarnReportController"
      stylesheets="@/css/style.css"
      style="-fx-background-color:#f0f4ff;" spacing="0">

    <HBox style="-fx-background-color:linear-gradient(to right,#0a1628,#065f46,#059669);
                 -fx-padding:14 24;-fx-alignment:center-left;" spacing="14">
        <VBox spacing="2">
            <Label text="REPORTS  ›  YARN"
                   style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:10px;-fx-font-weight:bold;"/>
            <Label text="Details Report of Yarn"
                   style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"/>
        </VBox>
    </HBox>

    <VBox style="-fx-padding:16;" spacing="14" VBox.vgrow="ALWAYS">

        <!-- Filter Card -->
        <VBox style="-fx-background-color:white;-fx-border-color:#86efac;-fx-border-width:1.5;
                     -fx-border-radius:14;-fx-background-radius:14;">
            <HBox styleClass="card-header-green" spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍" styleClass="icon-green"/>
                <VBox spacing="1">
                    <Label text="Search Filters" styleClass="card-title"/>
                    <Label text="Filter by worker, yarn count, date range or challan" styleClass="card-subtitle"/>
                </VBox>
            </HBox>
            <HBox style="-fx-padding:14 16;" spacing="14" alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="👤" styleClass="icon-blue"/>
                        <Label text="JOBWORKER" styleClass="label-blue"/>
                    </HBox>
                    <ComboBox fx:id="cbWorker" promptText="All workers" prefWidth="150" styleClass="input-field"/>
                </VBox>
                <VBox spacing="5">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="📅" styleClass="icon-blue"/>
                        <Label text="FROM DATE" styleClass="label-blue"/>
                    </HBox>
                    <DatePicker fx:id="dpFrom" prefWidth="140" styleClass="input-field"/>
                </VBox>
                <VBox spacing="5">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="📅" styleClass="icon-blue"/>
                        <Label text="TO DATE" styleClass="label-blue"/>
                    </HBox>
                    <DatePicker fx:id="dpTo" prefWidth="140" styleClass="input-field"/>
                </VBox>
                <VBox spacing="5">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="🔖" styleClass="icon-dblue"/>
                        <Label text="CHALLAN NO." styleClass="label-dblue"/>
                    </HBox>
                    <TextField fx:id="tfChallanNo" promptText="Enter challan no." prefWidth="130" styleClass="input-field"/>
                </VBox>
                <VBox spacing="5">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="🧶" styleClass="icon-green"/>
                        <Label text="YARN COUNT" styleClass="label-green"/>
                    </HBox>
                    <ComboBox fx:id="cbYarnCount" promptText="All counts" prefWidth="120" styleClass="input-field"/>
                </VBox>
                <Button text="🔍  Search" onAction="#onSearch"
                        style="-fx-background-color:linear-gradient(to right,#059669,#047857);
                               -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;
                               -fx-padding:9 18;-fx-background-radius:8;-fx-cursor:hand;"/>
            </HBox>
        </VBox>

        <!-- Results Card -->
        <VBox VBox.vgrow="ALWAYS"
              style="-fx-background-color:white;-fx-border-color:#dbeafe;-fx-border-width:1.5;
                     -fx-border-radius:14;-fx-background-radius:14;">
            <HBox styleClass="card-header-green" spacing="10" alignment="CENTER_LEFT">
                <Label text="📊" styleClass="icon-green"/>
                <Label text="Results" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotalWeight" styleClass="label-green"/>
                <Label text="   "/>
                <Label fx:id="lblTotalBags" styleClass="label-green"/>
            </HBox>

            <!-- colEdit and colDelete added ONLY in YarnReportController.initialize() -->
            <TableView fx:id="tblReport" VBox.vgrow="ALWAYS"
                       styleClass="table-green"
                       style="-fx-background-color:white;-fx-border-width:0;
                              -fx-background-radius:0 0 14 14;">
                <columns>
                    <TableColumn fx:id="colDate"    text="Date"        prefWidth="100"/>
                    <TableColumn fx:id="colChallan" text="Challan No." prefWidth="110"/>
                    <TableColumn fx:id="colColour"  text="Colour"      prefWidth="90"/>
                    <TableColumn fx:id="colCount"   text="Count"       prefWidth="80"/>
                    <TableColumn fx:id="colBags"    text="No. of Bags" prefWidth="90"/>
                    <TableColumn fx:id="colCones"   text="No. of Cones" prefWidth="100"/>
                    <TableColumn fx:id="colWeight"  text="Net Wt. (kg)" prefWidth="100"/>
                    <!-- colEdit and colDelete added programmatically -->
                </columns>
                <placeholder>
                    <Label text="No entries found — use the filters above and click Search"
                           style="-fx-text-fill:#94a3b8;-fx-font-size:13px;-fx-font-style:italic;"/>
                </placeholder>
            </TableView>

            <HBox style="-fx-padding:12 16;-fx-border-color:#86efac transparent transparent transparent;
                         -fx-border-width:1 0 0 0;-fx-background-color:#f8faff;
                         -fx-background-radius:0 0 14 14;" spacing="10">
                <Button text="📄  PDF"               onAction="#onPdf"       styleClass="btn-danger"/>
                <Button text="⊞  Excel"              onAction="#onExcel"     styleClass="btn-success"/>
                <Button text="📊  Yarn-wise Summary" onAction="#onCountWise" styleClass="btn-cyan"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
